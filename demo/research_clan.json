{
  "clan": {
    "name": "research-clan-alpha",
    "description": "Multi-agent research team for automated literature review and synthesis",
    "config": {
      "model_preference": "claude-3-5-sonnet",
      "max_tokens_per_agent": 4096,
      "temperature": 0.3
    }
  },
  "agents": [
    {
      "agent_id": "orchestrator-1",
      "name": "Research Orchestrator",
      "role": "orchestrator",
      "config": {
        "strategy": "divide-and-conquer",
        "max_sub_tasks": 5
      }
    },
    {
      "agent_id": "searcher-1",
      "name": "Literature Searcher",
      "role": "worker",
      "config": {
        "sources": ["arxiv", "pubmed", "semantic_scholar"],
        "max_results": 20
      }
    },
    {
      "agent_id": "analyzer-1",
      "name": "Content Analyzer",
      "role": "worker",
      "config": {
        "extraction_fields": ["methodology", "results", "limitations"],
        "summarize": true
      }
    },
    {
      "agent_id": "synthesizer-1",
      "name": "Synthesis Agent",
      "role": "worker",
      "config": {
        "output_format": "structured_report",
        "citation_style": "apa"
      }
    },
    {
      "agent_id": "validator-1",
      "name": "Quality Validator",
      "role": "validator",
      "config": {
        "checks": ["factual_accuracy", "citation_validity", "coherence"],
        "threshold": 0.85
      }
    },
    {
      "agent_id": "monitor-1",
      "name": "Execution Monitor",
      "role": "monitor",
      "config": {
        "alert_on_failure": true,
        "track_token_usage": true
      }
    }
  ],
  "governance": {
    "max_retries": 3,
    "timeout_s": 600,
    "max_concurrent_executions": 3,
    "allowed_agent_roles": ["orchestrator", "worker", "validator", "monitor"],
    "require_determinism_verification": true,
    "rules": [
      {
        "rule_id": "halt-on-validator-failure",
        "name": "Halt if validation fails",
        "condition": "validator_score < 0.7",
        "action": "halt",
        "enabled": true,
        "priority": 100
      },
      {
        "rule_id": "alert-on-retry",
        "name": "Alert on excessive retries",
        "condition": "retry_count >= 2",
        "action": "alert",
        "enabled": true,
        "priority": 50
      }
    ]
  }
}
